#!/usr/bin/env bash

if ((BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4))); then
    printf 'vpsctl 需要 Bash 4.4 或更高版本（当前：%s）。\n' "${BASH_VERSION:-未知}" >&2
    exit 3
fi

set -Eeuo pipefail
IFS=$'\n\t'
umask 022

readonly VPSCTL_VERSION="0.5.0"

VPSCTL_DRY_RUN=0
VPSCTL_INSTALL_DEPS=0
VPSCTL_ASSUME_YES=0
VPSCTL_NON_INTERACTIVE=0
VPSCTL_QUIET=0
VPSCTL_VERBOSE=0
VPSCTL_NO_COLOR=0
VPSCTL_CLEAR=1
VPSCTL_MENU_STATUS=0

vpsctl_resolve_project_root() {
    local source_dir

    source_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
    cd -- "${source_dir}/.." && pwd -P
}

VPSCTL_PROJECT_ROOT="$(vpsctl_resolve_project_root)"
readonly VPSCTL_PROJECT_ROOT

vpsctl_load_library() {
    local library_path="$1"

    if [[ ! -r "$library_path" ]]; then
        printf 'vpsctl：无法读取必需的库：%s\n' "$library_path" >&2
        exit 3
    fi

    # shellcheck source=/dev/null
    source "$library_path"
}

vpsctl_load_library "${VPSCTL_PROJECT_ROOT}/lib/environment.sh"
vpsctl_load_library "${VPSCTL_PROJECT_ROOT}/lib/distribution.sh"
vpsctl_load_library "${VPSCTL_PROJECT_ROOT}/lib/registry.sh"
vpsctl_load_library "${VPSCTL_PROJECT_ROOT}/lib/ui.sh"

vpsctl_usage() {
    cat <<'EOF'
VPS Script Lite - VPS 部署与维护控制台

用法：
  vpsctl [global-options]
  vpsctl [global-options] menu
  vpsctl [global-options] env
  vpsctl [global-options] list
  vpsctl [global-options] <domain> <action> [command-options]

内置命令：
  menu                 打开交互式管理控制台
  env                  检测并显示本机 VPS 环境
  list                 列出已登记的功能命令
  help                 显示此帮助

全局选项：
  --dry-run            让支持演练的功能只显示计划，不执行变更
  --install-deps       明确允许功能命令安装缺失依赖
  --yes                仅跳过允许自动确认的普通提示
  --non-interactive    禁止从终端读取输入
  --quiet              减少功能命令的非必要输出
  --verbose            启用附加诊断信息
  --no-color           禁用 ANSI 颜色
  --no-clear           在交互菜单中保留终端回滚内容
  -h, --help           显示此帮助
  -V, --version        显示 vpsctl 版本

未指定命令时，如果连接到终端，vpsctl 会打开菜单；否则只输出一次环境面板并退出。
EOF
}

vpsctl_error() {
    local red="" reset=""

    if [[ "${VPSCTL_NO_COLOR:-0}" == "0" && -t 2 && "${TERM:-dumb}" != "dumb" && -z "${NO_COLOR:-}" ]]; then
        red=$'\033[31m'
        reset=$'\033[0m'
    fi
    printf 'vpsctl：%s错误%s：%s\n' "$red" "$reset" "$1" >&2
}

vpsctl_handle_interrupt() {
    local cyan="" reset=""

    if [[ "${VPSCTL_NO_COLOR:-0}" == "0" && -t 2 && "${TERM:-dumb}" != "dumb" && -z "${NO_COLOR:-}" ]]; then
        cyan=$'\033[36m'
        reset=$'\033[0m'
    fi
    printf '\n%s操作已中断%s。\n' "$cyan" "$reset" >&2
    exit 130
}

vpsctl_parse_global_options() {
    VPSCTL_ARGS=()

    while (($# > 0)); do
        case "$1" in
            --dry-run)
                VPSCTL_DRY_RUN=1
                ;;
            --install-deps)
                VPSCTL_INSTALL_DEPS=1
                ;;
            --yes)
                VPSCTL_ASSUME_YES=1
                ;;
            --non-interactive)
                VPSCTL_NON_INTERACTIVE=1
                ;;
            --quiet)
                VPSCTL_QUIET=1
                ;;
            --verbose)
                VPSCTL_VERBOSE=1
                ;;
            --no-color)
                VPSCTL_NO_COLOR=1
                ;;
            --no-clear)
                VPSCTL_CLEAR=0
                ;;
            -h | --help)
                VPSCTL_ARGS=("help")
                return 0
                ;;
            -V | --version)
                VPSCTL_ARGS=("version")
                return 0
                ;;
            --)
                shift
                VPSCTL_ARGS=("$@")
                return 0
                ;;
            -*)
                vpsctl_error "未知全局选项：$1"
                return 2
                ;;
            *)
                VPSCTL_ARGS=("$@")
                return 0
                ;;
        esac
        shift
    done
}

vpsctl_export_context() {
    export VPSCTL_PROJECT_ROOT VPSCTL_DRY_RUN VPSCTL_INSTALL_DEPS VPSCTL_ASSUME_YES
    export VPSCTL_NON_INTERACTIVE VPSCTL_QUIET VPSCTL_VERBOSE VPSCTL_NO_COLOR VPSCTL_CLEAR
    export VPSCTL_DISTRIBUTED VPSCTL_INSTALL_ROOT VPSCTL_SELF_STATE_ROOT VPSCTL_MANAGED_ENTRY
    export VPSCTL_ENV_OS_ID="${VPS_ENV[os_id]}"
    export VPSCTL_ENV_OS_VERSION_ID="${VPS_ENV[os_version_id]}"
    export VPSCTL_ENV_ARCH="${VPS_ENV[architecture]}"
    export VPSCTL_ENV_INIT="${VPS_ENV[init_system]}"
    export VPSCTL_ENV_PACKAGE_MANAGER="${VPS_ENV[package_manager]}"
    export VPSCTL_ENV_VIRTUALIZATION="${VPS_ENV[virtualization]}"
}

vpsctl_invocation_may_omit_requirement() {
    local command_key="$1"
    local requirement="$2"
    shift 2

    case "${command_key}:${requirement}" in
        test:nodequality:root | test:tcpquality:root)
            (($# == 1)) || return 1
            case "$1" in
                help | -h | --help) return 0 ;;
            esac
            ;;
        network:rfw:init:systemd)
            (($# == 1)) || return 1
            case "$1" in
                help | -h | --help | status) return 0 ;;
            esac
            ;;
        security:access:init:systemd)
            if (($# == 1)); then
                case "$1" in
                    help | -h | --help | status) return 0 ;;
                esac
            elif [[ "$1" == "status" ]]; then
                shift
                while (($# > 0)); do
                    case "$1" in
                        --json) shift ;;
                        --user)
                            (($# >= 2)) || return 1
                            shift 2
                            ;;
                        *) return 1 ;;
                    esac
                done
                return 0
            elif (($# == 4)) && [[ "$1" == "session" && "$2" == "verify" && "$3" == "--transaction" && -n "$4" ]]; then
                return 0
            fi
            ;;
        security:fail2ban:init:systemd)
            if (($# == 1)); then
                case "$1" in
                    help | -h | --help | status) return 0 ;;
                esac
            elif (($# == 2)) && [[ "$1" == "status" && "$2" == "--json" ]]; then
                return 0
            fi
            ;;
        service:proxy:service:any)
            if (($# == 1)); then
                case "$1" in
                    help | -h | --help | profiles | status) return 0 ;;
                esac
            elif (($# == 2)) && [[ "$1" == "time" && "$2" == "status" ]]; then
                return 0
            elif (($# == 3)) && [[ "$1" == "time" && "$2" == "status" && "$3" == "--json" ]]; then
                return 0
            fi
            ;;
    esac
    return 1
}

vpsctl_invocation_requirements() {
    local command_key="$1"
    shift

    local registered_requirements requirement joined=""
    local -a requirement_list=()

    registered_requirements="${VPS_COMMAND_REQUIREMENTS[$command_key]}"
    if [[ -z "$registered_requirements" || "$registered_requirements" == "none" ]]; then
        printf 'none'
        return 0
    fi

    local old_ifs="$IFS"
    IFS=','
    read -r -a requirement_list <<<"$registered_requirements"
    IFS="$old_ifs"

    for requirement in "${requirement_list[@]}"; do
        requirement="$(vps_env_trim "$requirement")"
        [[ -n "$requirement" ]] || continue
        if vpsctl_invocation_may_omit_requirement "$command_key" "$requirement" "$@"; then
            continue
        fi
        [[ -n "$joined" ]] && joined+=","
        joined+="$requirement"
    done
    printf '%s' "${joined:-none}"
}

vpsctl_validate_command_ready() {
    local command_key="$1"
    shift
    local privilege requirements

    privilege="${VPS_COMMAND_PRIVILEGE[$command_key]}"
    requirements="$(vpsctl_invocation_requirements "$command_key" "$@")"

    if [[ "$privilege" == "root" && "${VPS_ENV[is_root]}" != "yes" ]] && \
        ! vpsctl_invocation_may_omit_requirement "$command_key" root "$@"; then
        vpsctl_error "${command_key} 需要 root 权限"
        return 4
    fi

    if ! vps_env_requirements_met "$requirements"; then
        vpsctl_error "${command_key} 当前不可用；缺少能力：${VPS_ENV_MISSING_REQUIREMENTS}"
        return 3
    fi
}

vpsctl_dispatch() {
    local domain="$1"
    local action="$2"
    shift 2

    local command_key="${domain}:${action}"
    local relative_path command_path validation_status path_component checked_path
    local -a path_components=()

    if ! vps_registry_has_command "$command_key"; then
        vpsctl_error "未知命令：${domain} ${action}"
        return 2
    fi

    if vps_distribution_ensure_domain "$(vps_registry_distribution_domain "$domain")"; then
        :
    else
        return $?
    fi

    if vpsctl_validate_command_ready "$command_key" "$@"; then
        :
    else
        validation_status=$?
        return "$validation_status"
    fi

    relative_path="${VPS_COMMAND_PATH[$command_key]}"
    command_path="${VPSCTL_PROJECT_ROOT}/${relative_path}"

    checked_path="$VPSCTL_PROJECT_ROOT"
    IFS='/' read -r -a path_components <<<"$relative_path"
    for path_component in "${path_components[@]}"; do
        checked_path="${checked_path}/${path_component}"
        if [[ -L "$checked_path" ]]; then
            vpsctl_error "已登记命令路径不能包含符号链接：${relative_path}"
            return 3
        fi
    done
    if [[ ! -f "$command_path" ]]; then
        vpsctl_error "已登记命令文件不存在：${relative_path}"
        return 3
    fi
    if [[ ! -r "$command_path" ]]; then
        vpsctl_error "无法读取已登记命令：${relative_path}"
        return 3
    fi

    vpsctl_export_context
    if BASH_ENV='' ENV='' bash --noprofile --norc "$command_path" "$@"; then
        return 0
    else
        return $?
    fi
}

vpsctl_run_domain_menu() {
    local domain="$1"
    local choice command_index command_key status notice=""

    while true; do
        vps_registry_commands_for_domain "$domain"
        vps_ui_clear_screen
        vps_ui_header "主菜单 / ${VPS_DOMAIN_LABEL[$domain]}"
        vps_ui_domain_commands "$domain"

        if ((${#VPS_REGISTRY_RESULTS[@]} == 0)); then
            vps_ui_info "该分类暂未登记功能脚本。"
            vps_ui_pause
            return 0
        fi

        vps_ui_nav_line b "返回主菜单" q "退出"
        if [[ -n "$notice" ]]; then
            vps_ui_warning "$notice"
            notice=""
        fi
        vps_ui_read_choice "请选择功能" || return "$VPSCTL_MENU_STATUS"
        choice="$VPS_UI_CHOICE"

        case "$choice" in
            b | B | '')
                return 0
                ;;
            q | Q)
                exit "$VPSCTL_MENU_STATUS"
                ;;
            *)
                if vps_ui_parse_index "$choice" "${#VPS_REGISTRY_RESULTS[@]}"; then
                    command_index="$VPS_UI_INDEX"
                    command_key="${VPS_REGISTRY_RESULTS[$command_index]}"
                    if vpsctl_dispatch "${VPS_COMMAND_DOMAIN[$command_key]}" "${VPS_COMMAND_ACTION[$command_key]}"; then
                        status=0
                    else
                        status=$?
                    fi
                    VPSCTL_MENU_STATUS="$status"
                    printf '\n %s命令已结束%s  退出码 ' "$VPS_UI_CYAN" "$VPS_UI_RESET"
                    vps_ui_exit_code "$status"
                    printf '\n'
                    vps_ui_pause
                else
                    notice="选择无效，请输入列表中的编号、b 返回或 q 退出"
                fi
                ;;
        esac
    done
}

vpsctl_validate_menu_options() {
    local invalid="" option

    for option in \
        "${VPSCTL_DRY_RUN}:--dry-run" \
        "${VPSCTL_INSTALL_DEPS}:--install-deps" \
        "${VPSCTL_ASSUME_YES}:--yes" \
        "${VPSCTL_NON_INTERACTIVE}:--non-interactive" \
        "${VPSCTL_QUIET}:--quiet" \
        "${VPSCTL_VERBOSE}:--verbose"; do
        [[ "${option%%:*}" == "1" ]] || continue
        [[ -z "$invalid" ]] || invalid+=", "
        invalid+="${option#*:}"
    done
    [[ -z "$invalid" ]] || {
        vpsctl_error "交互菜单不能使用执行型全局选项：${invalid}"
        return 2
    }
}

vpsctl_run_menu() {
    local choice domain_index domain notice=""

    vpsctl_validate_menu_options || return $?
    if [[ ! -t 0 || ! -t 1 ]]; then
        vpsctl_error "交互菜单需要终端"
        return 2
    fi

    vps_env_detect

    while true; do
        vps_ui_clear_screen
        vps_ui_dashboard "$VPSCTL_VERSION"
        vps_ui_main_menu
        if [[ -n "$notice" ]]; then
            vps_ui_warning "$notice"
            notice=""
        fi
        vps_ui_read_choice "请选择" || return "$VPSCTL_MENU_STATUS"
        choice="$VPS_UI_CHOICE"

        case "$choice" in
            q | Q)
                return "$VPSCTL_MENU_STATUS"
                ;;
            *)
                if vps_ui_parse_index "$choice" "${#VPS_DOMAIN_IDS[@]}"; then
                    domain_index="$VPS_UI_INDEX"
                    domain="${VPS_DOMAIN_IDS[$domain_index]}"
                    vpsctl_run_domain_menu "$domain"
                    # Feature commands run in child processes. Refresh the parent
                    # snapshot so dashboard fields such as BBR reflect changes.
                    vps_env_detect
                else
                    notice="选择无效，请输入列表中的编号或 q 退出"
                fi
                ;;
        esac
    done
}

vpsctl_show_environment() {
    vps_env_detect
    vps_ui_dashboard "$VPSCTL_VERSION"
    vps_ui_environment_details
}

vpsctl_show_registered_commands() {
    vps_env_detect
    vps_ui_header "已登记功能"
    vps_ui_registered_commands
}

vpsctl_main() {
    trap vpsctl_handle_interrupt INT TERM

    if ! vpsctl_parse_global_options "$@"; then
        vpsctl_usage >&2
        return 2
    fi

    vps_registry_init
    vps_ui_init

    if ((${#VPSCTL_ARGS[@]} == 0)); then
        if [[ "$VPSCTL_NON_INTERACTIVE" == "0" && -t 0 && -t 1 ]]; then
            vpsctl_run_menu
        else
            vpsctl_show_environment
        fi
        return $?
    fi

    case "${VPSCTL_ARGS[0]}" in
        help)
            if ((${#VPSCTL_ARGS[@]} != 1)); then
                vpsctl_error "help 不接受额外参数"
                return 2
            fi
            vpsctl_usage
            ;;
        version)
            if ((${#VPSCTL_ARGS[@]} != 1)); then
                vpsctl_error "version 不接受额外参数"
                return 2
            fi
            printf 'vpsctl %s\n' "$VPSCTL_VERSION"
            ;;
        menu)
            if ((${#VPSCTL_ARGS[@]} != 1)); then
                vpsctl_error "menu 不接受额外参数"
                return 2
            fi
            vpsctl_run_menu
            ;;
        env)
            if ((${#VPSCTL_ARGS[@]} != 1)); then
                vpsctl_error "env 不接受额外参数"
                return 2
            fi
            vpsctl_show_environment
            ;;
        list)
            if ((${#VPSCTL_ARGS[@]} != 1)); then
                vpsctl_error "list 不接受额外参数"
                return 2
            fi
            vpsctl_show_registered_commands
            ;;
        *)
            if ((${#VPSCTL_ARGS[@]} < 2)); then
                vpsctl_error "需要指定 <domain> <action>"
                return 2
            fi
            vps_env_detect
            vpsctl_dispatch "${VPSCTL_ARGS[0]}" "${VPSCTL_ARGS[1]}" "${VPSCTL_ARGS[@]:2}"
            ;;
    esac
}

vpsctl_main "$@"
